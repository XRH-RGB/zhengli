# 默认仅配置模式。设为 true 才允许同步仓库、调用模型和运行工作流。
EXECUTION_ENABLED=false
# 本机使用可留空；远程部署必须配置，并在界面输入同一访问密钥。
APP_API_KEY=
# GitHub 私有知识库需要 Contents: read 权限；仅在服务端保存。
GITHUB_TOKEN=
# 填写兼容 /chat/completions、/embeddings 的接口根地址（通常以 /v1 结尾）。
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
DATA_DIR=data
CHUNK_SIZE=1800
CHUNK_OVERLAP=240
MAX_FILES=300
MAX_FILE_BYTES=200000
MAX_CHUNKS=5000
MAX_CONTEXT_CHARS=16000
REQUEST_TIMEOUT=60
